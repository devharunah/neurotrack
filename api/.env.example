# Supabase project URL. The API fetches the JWKS from here to verify user access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional (Research Assistant). An NCBI E-utilities API key raises the PubMed limit from 3 to 10
# requests per second. Never required.
NCBI_API_KEY=
# Optional. URL of a local Ollama server, e.g. http://127.0.0.1:11434, for nicer summaries.
# Unset means answers are built extractively from retrieved abstracts, with no LLM at all.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# Optional. Seconds to wait for one Europe PMC / NCBI request, and for one Ollama completion.
RESEARCH_TIMEOUT_S=15
OLLAMA_TIMEOUT_S=60

# "development" (default) or "production". Production turns on HSTS and requires ALLOWED_HOSTS.
ENVIRONMENT=development
# Comma-separated Host headers the API answers to. "*" (default) is for development only.
ALLOWED_HOSTS=*
# Set true only behind a proxy that appends to X-Forwarded-For (Render, Fly.io, HF Spaces); the
# right-most entry is used.
TRUST_PROXY_HEADERS=false
# Request bodies above this many bytes get 413.
MAX_BODY_BYTES=2097152
# Token-bucket rate limits per client (verified JWT sub, else IP). Each strict prefix has its own bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST=60
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_STRICT_BURST=10
RATE_LIMIT_STRICT_PER_MINUTE=20
RATE_LIMIT_STRICT_PREFIXES=/quantum/,/research/,/behaviour/
