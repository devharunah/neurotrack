{
  "openapi": "3.1.0",
  "info": {
    "title": "NeuroTrack API",
    "description": "Scientific computation for NeuroTrack. Educational and experimental; not a clinical tool.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/quantum/presets": {
      "get": {
        "tags": [
          "quantum"
        ],
        "summary": "List Presets",
        "operationId": "list_presets_quantum_presets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Preset"
                  },
                  "type": "array",
                  "title": "Response List Presets Quantum Presets Get"
                }
              }
            }
          }
        }
      }
    },
    "/quantum/run": {
      "post": {
        "tags": [
          "quantum"
        ],
        "summary": "Run",
        "operationId": "run_quantum_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/quantum/qml/compare": {
      "post": {
        "tags": [
          "quantum"
        ],
        "summary": "Qml Compare",
        "operationId": "qml_compare_quantum_qml_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QmlCompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QmlCompareResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/behaviour/associations": {
      "post": {
        "tags": [
          "behaviour"
        ],
        "summary": "Post Associations",
        "operationId": "post_associations_behaviour_associations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssociationsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssociationsResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/behaviour/summary": {
      "post": {
        "tags": [
          "behaviour"
        ],
        "summary": "Post Summary",
        "operationId": "post_summary_behaviour_summary_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RowsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Amplitude": {
        "properties": {
          "basis": {
            "type": "string",
            "title": "Basis"
          },
          "re": {
            "type": "number",
            "title": "Re"
          },
          "im": {
            "type": "number",
            "title": "Im"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          }
        },
        "type": "object",
        "required": [
          "basis",
          "re",
          "im",
          "probability"
        ],
        "title": "Amplitude"
      },
      "Association": {
        "properties": {
          "pair": {
            "type": "string",
            "enum": [
              "stress_craving",
              "sleep_craving",
              "mood_craving",
              "time_of_day_craving"
            ],
            "title": "Pair"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "method": {
            "type": "string",
            "enum": [
              "spearman",
              "kruskal_wallis"
            ],
            "title": "Method"
          },
          "statistic": {
            "type": "string",
            "enum": [
              "rho",
              "epsilon_squared"
            ],
            "title": "Statistic"
          },
          "n": {
            "type": "integer",
            "title": "N"
          },
          "sufficient": {
            "type": "boolean",
            "title": "Sufficient"
          },
          "estimate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimate"
          },
          "ci_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci Low"
          },
          "ci_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci High"
          },
          "p_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P Value"
          },
          "p_value_holm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P Value Holm",
            "description": "Holm-adjusted across the pairs in this response that had enough data."
          },
          "strength": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "negligible",
                  "weak",
                  "moderate",
                  "strong"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Strength"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "positive",
                  "negative"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          },
          "groups": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TimeBucket"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Groups"
          }
        },
        "type": "object",
        "required": [
          "pair",
          "label",
          "method",
          "statistic",
          "n",
          "sufficient",
          "estimate",
          "ci_low",
          "ci_high",
          "p_value",
          "p_value_holm",
          "strength",
          "direction",
          "interpretation"
        ],
        "title": "Association"
      },
      "AssociationsRequest": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ObservationRow"
            },
            "type": "array",
            "maxItems": 20000,
            "title": "Rows"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "description": "Whether the rows are synthetic. Echoed back so it stays labelled.",
            "default": true
          },
          "seed": {
            "type": "integer",
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 20261120
          }
        },
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "AssociationsRequest"
      },
      "AssociationsResult": {
        "properties": {
          "associations": {
            "items": {
              "$ref": "#/components/schemas/Association"
            },
            "type": "array",
            "title": "Associations"
          },
          "n_rows": {
            "type": "integer",
            "title": "N Rows"
          },
          "n_participants": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N Participants"
          },
          "bootstrap_unit": {
            "type": "string",
            "enum": [
              "participant",
              "observation"
            ],
            "title": "Bootstrap Unit"
          },
          "resamples": {
            "type": "integer",
            "title": "Resamples"
          },
          "confidence_level": {
            "type": "number",
            "title": "Confidence Level"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "min_n": {
            "type": "integer",
            "title": "Min N"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "associations",
          "n_rows",
          "n_participants",
          "bootstrap_unit",
          "resamples",
          "confidence_level",
          "seed",
          "min_n",
          "synthetic",
          "notice"
        ],
        "title": "AssociationsResult"
      },
      "CircuitSpec": {
        "properties": {
          "num_qubits": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Num Qubits"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/Gate"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Gates"
          }
        },
        "type": "object",
        "required": [
          "num_qubits"
        ],
        "title": "CircuitSpec"
      },
      "FieldSummary": {
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "mood",
              "stress",
              "sleep_quality",
              "craving_intensity"
            ],
            "title": "Field"
          },
          "n": {
            "type": "integer",
            "title": "N"
          },
          "missing": {
            "type": "integer",
            "title": "Missing"
          },
          "missing_fraction": {
            "type": "number",
            "title": "Missing Fraction"
          },
          "mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean"
          },
          "sd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sd"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "q1": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Q1"
          },
          "median": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median"
          },
          "q3": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Q3"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          }
        },
        "type": "object",
        "required": [
          "field",
          "n",
          "missing",
          "missing_fraction",
          "mean",
          "sd",
          "min",
          "q1",
          "median",
          "q3",
          "max"
        ],
        "title": "FieldSummary"
      },
      "Gate": {
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "x",
              "y",
              "z",
              "h",
              "cx"
            ],
            "title": "Op"
          },
          "target": {
            "type": "integer",
            "exclusiveMaximum": 8.0,
            "minimum": 0.0,
            "title": "Target"
          },
          "control": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMaximum": 8.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Control"
          }
        },
        "type": "object",
        "required": [
          "op",
          "target"
        ],
        "title": "Gate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelScore": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "family": {
            "type": "string",
            "title": "Family"
          },
          "accuracy": {
            "type": "number",
            "title": "Accuracy"
          },
          "f1": {
            "type": "number",
            "title": "F1"
          },
          "train_ms": {
            "type": "number",
            "title": "Train Ms"
          },
          "predict_ms": {
            "type": "number",
            "title": "Predict Ms"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "name",
          "family",
          "accuracy",
          "f1",
          "train_ms",
          "predict_ms",
          "notes"
        ],
        "title": "ModelScore"
      },
      "NoiseConfig": {
        "properties": {
          "depolarizing_1q": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Depolarizing 1Q",
            "default": 0.0
          },
          "depolarizing_2q": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Depolarizing 2Q",
            "default": 0.0
          },
          "readout": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Readout",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "NoiseConfig",
        "description": "Simple, documented noise: depolarizing gate errors plus symmetric readout error."
      },
      "ObservationRow": {
        "properties": {
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At",
            "description": "When the observation was made. Send the local wall time with its UTC offset (for example 2026-11-20T19:30:00+03:00); time-of-day buckets use the hour as given."
          },
          "participant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant",
            "description": "Pseudonymous participant key. When present, the bootstrap resamples participants rather than single observations, which respects repeated measures."
          },
          "mood": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Mood"
          },
          "stress": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stress"
          },
          "sleep_quality": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Quality"
          },
          "craving_intensity": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Craving Intensity"
          }
        },
        "type": "object",
        "required": [
          "observed_at"
        ],
        "title": "ObservationRow",
        "description": "One self-reported observation. Scores are 0-10; null means not answered."
      },
      "Preset": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "circuit": {
            "$ref": "#/components/schemas/CircuitSpec"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "circuit"
        ],
        "title": "Preset"
      },
      "QmlCompareRequest": {
        "properties": {
          "samples": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 20.0,
            "title": "Samples",
            "default": 80
          },
          "noise": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Noise",
            "description": "Label-flip probability",
            "default": 0.1
          },
          "feature_map_reps": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Feature Map Reps",
            "default": 2
          },
          "feature_scale": {
            "type": "number",
            "maximum": 3.1416,
            "minimum": 0.1,
            "title": "Feature Scale",
            "description": "Features are scaled to [0, feature_scale] before encoding. This acts as the kernel bandwidth: too large and the kernel memorises (near-identity Gram matrix), too small and every point looks alike.",
            "default": 1.0
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed",
            "default": 7
          }
        },
        "type": "object",
        "title": "QmlCompareRequest"
      },
      "QmlCompareResult": {
        "properties": {
          "dataset": {
            "additionalProperties": true,
            "type": "object",
            "title": "Dataset"
          },
          "quantum_resources": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Quantum Resources"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelScore"
            },
            "type": "array",
            "title": "Models"
          },
          "caveat": {
            "type": "string",
            "title": "Caveat",
            "default": "Synthetic data, simulated (noise-free) quantum kernel. These numbers compare methods on a toy problem only. They do not demonstrate quantum advantage and say nothing about real behaviour or any individual."
          }
        },
        "type": "object",
        "required": [
          "dataset",
          "quantum_resources",
          "models"
        ],
        "title": "QmlCompareResult"
      },
      "RowsRequest": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ObservationRow"
            },
            "type": "array",
            "maxItems": 20000,
            "title": "Rows"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "description": "Whether the rows are synthetic. Echoed back so it stays labelled.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "RowsRequest"
      },
      "RunRequest": {
        "properties": {
          "num_qubits": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Num Qubits"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/Gate"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Gates"
          },
          "shots": {
            "type": "integer",
            "maximum": 8192.0,
            "minimum": 1.0,
            "title": "Shots",
            "default": 1024
          },
          "noise": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NoiseConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "num_qubits"
        ],
        "title": "RunRequest"
      },
      "RunResult": {
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Probabilities"
          },
          "statevector": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Amplitude"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Statevector"
          },
          "diagram": {
            "type": "string",
            "title": "Diagram"
          },
          "depth": {
            "type": "integer",
            "title": "Depth"
          },
          "shots": {
            "type": "integer",
