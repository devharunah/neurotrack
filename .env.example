NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Base URL of the FastAPI service in api/. Never prefix with NEXT_PUBLIC_.
NEUROTRACK_API_URL=http://127.0.0.1:8000

# Optional, for the authenticated Playwright flows (e2e/*.spec.ts). Use a dedicated test user.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional, a second dedicated test user for the cross-user RLS checks in e2e/privacy.spec.ts.
# That spec also reads NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY from the
# environment Playwright runs in.
E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=
